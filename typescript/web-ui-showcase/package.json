{
  "name": "@qoder-samples/typescript-web-ui-showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client npm:dev:server npm:dev:client",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch src/server/main.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env scripts/start-production.mjs",
    "typecheck": "tsc -p tsconfig.client.json --noEmit --pretty false && tsc -p tsconfig.server.json --noEmit --pretty false && tsc -p tsconfig.test.json --noEmit --pretty false",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "playwright test",
    "test:smoke:production": "node --import tsx test/smoke/production-server-smoke.ts",
    "test:smoke:real": "node --env-file-if-exists=.env --import tsx test/smoke/real-sdk-smoke.ts",
    "check:boundary": "node scripts/check-sdk-import-boundary.mjs",
    "check": "npm run typecheck && npm run check:boundary && npm run test:unit && npm run test:integration && npm run build && npm run test:smoke:production && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.0",
    "@qoder-ai/qoder-agent-sdk": "^1.0.21",
    "fastify": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.8",
    "ws": "^8.21.0"
  }
}
